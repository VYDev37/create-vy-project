{
  "name": "create-vy-project",
  "version": "0.2.0",
  "description": "Fast scaffolding CLI for Next.js 16, React 19 Vite, Go Fiber, and Discord Bot projects",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "create-vy-project": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "skills",
    "README.md"
  ],
  "scripts": {
    "dev": "npx tsx src/index.ts",
    "copy-assets": "node scripts/copy-assets.js",
    "build": "tsc && node scripts/copy-assets.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "create-vy-project",
    "nextjs",
    "react",
    "vite",
    "go-fiber",
    "discord-bot",
    "discord-js",
    "scaffold",
    "cli"
  ],
  "author": "VYDev37",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "execa": "^9.5.2",
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VYDev37/create-vy-project"
  }
}